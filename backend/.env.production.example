APP_NAME="ApexGarage"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.apexgarage.lk

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=apexgarage
DB_USERNAME=apexgarage
DB_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

APEX_DEFAULT_TENANT=colombo-hq
APEX_TOKEN_TTL_DAYS=30
APEX_MEDIA_DISK=s3

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=app.apexgarage.lk,admin.apexgarage.lk
